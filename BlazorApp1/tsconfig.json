{
  "compilerOptions": {
    "module": "ES2020",
    "noEmitOnError": true,
    "noImplicitAny": false,
    "outDir": "./wwwroot/scripts/js",
    "removeComments": false,
    "rootDir": "./Scripts",
    "sourceMap": true,
    "strict": true,
    "target": "ES2020"
  },

  "include": [
    "./Scripts/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "wwwroot/scripts/js"
  ]
}